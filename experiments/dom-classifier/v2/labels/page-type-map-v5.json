{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page-type collapse, dom-taxonomy-v2 to dom-pagetype-v5",
  "mappingRevision": "dom-pagetype-v5",
  "sourceTaxonomyRevision": "dom-taxonomy-v2",
  "rationale": "Prompt revision v4 asked 65 independent yes/no page-type questions per page. The two annotators agreed on the resulting label set 1.3% of the time on the frozen test split and 16.0% on the pilot pool, so the axis measured the question rather than the page. v5 asks one Choice over 11 classes. This file is the projection used to compare a v4 label set against a v5 choice; it is never applied to v5 outputs, which are already in the collapsed vocabulary.",
  "projection": {
    "direction": "dom-taxonomy-v2 pageTypes -> dom-pagetype-v5 classes",
    "lossy": true,
    "note": "A v4 label set projects to a SET of v5 classes. Agreement against a v5 single choice is scored as membership, which is generous to v4; the pilot reports it that way and says so."
  },
  "classes": [
