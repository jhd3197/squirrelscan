{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "*.ts",
    "runtime/*.ts",
    "train/*.ts",
    "experiments/*.ts"
  ]
}
